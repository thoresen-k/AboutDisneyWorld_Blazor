@page "/updatephoto/{id}"
@using Amazon.S3
@using MongoDB.Driver
@using ImageSharp = SixLabors.ImageSharp 
@using MongoDB.Bson
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@inject MongoDBPhotoService PhotoService
@inject IPhotoFormService PhotoFormService
@inject CloudflareR2Service CloudflareR2Service
@inject IWebHostEnvironment Env
@inject NavigationManager Navigation

<PageTitle>Update Photo</PageTitle>

<div class="mb-3">
    <h3>Update Photo</h3>

    <PhotoForm Model="@photo" OnValidSubmit="EditPhoto" OnChange="HandleFileSelected" IsProcessing="@isEditing" FormName="EditPhotoForm" />
</div>

@code {
    private Photo photo = new();
    private Photo origPhoto = new();
    private IBrowserFile? file;
    bool isEditing = false;

    [Parameter]
    public string id { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine($"Photo ID from route: {id}");

        try
        {
            Photo fullPhoto = await PhotoService.GetPhotoByIdAsync(id);
            if(photo is null)
            {
                PhotoFormService.ErrorMessage = "Failed to get photo. Please refresh the page.";
            }
            else
            {
                photo = ClonePhoto(fullPhoto);
                origPhoto = ClonePhoto(fullPhoto);
            }
        }
        catch(MongoException mongoEx)
        {
            PhotoFormService.ErrorMessage = "Failed to get photo. Please refresh the page.";
            Console.WriteLine($"Mongo Error: {mongoEx.Message}");
        }

    }
    private Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        // the form component already updated the `newPhoto` model,
        // so just log or perform any additional bookkeeping here.
        file = e.File;
        Console.WriteLine($"PhotoForm raised OnChange, current file: {photo.FileName}");
        return Task.CompletedTask;
    }

    private static Photo ClonePhoto(Photo source) => new()
    {
        ID = source.ID,
        FileName = source.FileName,
        Title = source.Title,
        Caption = source.Caption,
        ImageSrc = source.ImageSrc,
        Date = source.Date
    };

    private async Task EditPhoto()
    {
        isEditing = true;
        bool cloudflareAddSuccess = false;
        bool cloudflareDeleteSuccess = false;
        bool mongoUpdateSuccess = false;

        Console.WriteLine($"Title: {photo.Title}");
        Console.WriteLine($"Name: {photo.FileName}");

        try
        {
            if(file is not null && !string.Equals(file.Name, photo.FileName, StringComparison.OrdinalIgnoreCase))
            {
                await CloudflareR2Service.PutObject(file);
                Console.WriteLine($"Updated photo added to Cloudflare");
                cloudflareAddSuccess = true;
                photo.ImageSrc = $"https://thoresen-disneyphotos.com/{file.Name}";
            }

            await PhotoService.UpdateAsync(photo);
            Console.WriteLine($"Updated photo added to MongoDB");
            mongoUpdateSuccess = true;

            if(file is not null && !string.Equals(file.Name, photo.FileName, StringComparison.OrdinalIgnoreCase) && cloudflareAddSuccess) 
            {
                await CloudflareR2Service.DeleteObject(origPhoto);
                Console.WriteLine($"Original photo deleted from Cloudflare");
                cloudflareDeleteSuccess = true;
            }

            Navigation.NavigateTo("/");
        }
        catch (AmazonS3Exception awsEx) 
        {
            Console.WriteLine($"Cloudflare {(!cloudflareDeleteSuccess ? "delete" : "add")} error code: {awsEx.ErrorCode}");
            Console.WriteLine($"Cloudflare {(!cloudflareDeleteSuccess ? "delete" : "add")} error message: {awsEx.Message}"); 

            // If the new image was not uploaded
            if(!mongoUpdateSuccess)
            {
                PhotoFormService.ErrorMessage = "Uploading the new image failed. Please try again.";
                //photo.ImageSrc = $"https://thoresen-disneyphotos.com/{photo.FileName}";
            }
            // If the new photo uploaded but deleting the original photo failed
            else
            {
                PhotoFormService.ErrorMessage = "Deleting the original image failed. Please try again.";
            }
        }
        catch (MongoException mongoEx) 
        {
            PhotoFormService.ErrorMessage = "Update failed. Please try again.";

            Console.WriteLine($"Mongo failure: {mongoEx.Message}");
        }
        finally
        {
            isEditing = false;
        }
    }
}