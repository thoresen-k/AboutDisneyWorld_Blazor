@page "/addphoto"
@using MongoDB.Driver
@using SixLabors.ImageSharp
@using SixLabors.ImageSharp.Processing
@using Amazon.S3
@inject MongoDBPhotoService PhotoService
@inject IPhotoFormService PhotoFormService
@inject CloudflareR2Service CloudflareR2Service
@inject IWebHostEnvironment Env
@inject NavigationManager Navigation

<PageTitle>Add Photo</PageTitle>

<div class="mb-3">
    <h3>Add Photo</h3>

    <PhotoForm Model="@newPhoto" OnValidSubmit="InsertPhoto" OnChange="HandleFileSelected" IsProcessing="@isAdding" FormName="AddPhotoForm" />
</div>

@code {
    private Photo newPhoto = new();
    private IBrowserFile? file;
    private bool isAdding;

    private Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        // the form component already updated the `newPhoto` model,
        // so just log or perform any additional bookkeeping here.
        file = e.File;
        Console.WriteLine($"PhotoForm raised OnChange, current file: {newPhoto.FileName}");
        return Task.CompletedTask;
    }

    private async Task InsertPhoto()
    {
        isAdding = true;

        try 
        {
            await CloudflareR2Service.PutObject(file);
            Console.WriteLine($"Photo added to Cloudflare");
            
            newPhoto.ImageSrc = $"https://thoresen-disneyphotos.com/{newPhoto.FileName}";
            
            await PhotoService.AddAsync(newPhoto);
            Console.WriteLine($"Photo added to Mongo");

            Navigation.NavigateTo("/");
        }
        catch(AmazonS3Exception awsEx)
        {
            PhotoFormService.ErrorMessage = "The image upload failed. Please try again.";
            
            Console.WriteLine($"Cloudflare error code: {awsEx.ErrorCode}");
            Console.WriteLine($"Cloudflare error message: {awsEx.Message}");
        }
        catch(MongoException mongoEx)
        {
            PhotoFormService.ErrorMessage = "The image upload failed. Please try again.";

            Console.WriteLine($"Mongo upload failed: {mongoEx.Message}");

            // Cleanup Cloudflare
            try 
            {
                await CloudflareR2Service.DeleteObject(newPhoto);
            }
            catch(AmazonS3Exception awsEx)
            {
                Console.WriteLine($"Cloudflare error code: {awsEx.ErrorCode}");
                Console.WriteLine($"Cloudflare error message: {awsEx.Message}");
            }
        }
        finally
        {
            isAdding = false;
        }
    }
}