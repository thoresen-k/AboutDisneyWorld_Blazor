<Modal @ref="modal" Title="@title" IsScrollable="true" CloseOnEscape="false" UseStaticBackdrop="true">
    <BodyTemplate>
        @if(isLoading)
        {
            <div class="mx-auto">
                <img src="mickeymouse.png" style="height: 50px;"> Loading...
            </div>
        }
        else if(selectedPhoto is null)
        {
            <div class="alert alert-danger mb-0">
                Error displaying image. Please try again.
            </div>
        }
        else
        {
            <p>Caption: @selectedPhoto?.Caption </p>
            <p>Uploaded Date: @selectedPhoto?.Date</p>
            <img src="@fullImageData" class="img-fluid rounded" style="display: block; margin: 0 auto"/>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" Class="mx-auto" @onclick="CloseModal">Close</Button>
    </FooterTemplate>
</Modal>

@code {
    [Parameter]
    public Photo? selectedPhoto { get; set; } = new();

    [Parameter]
    public EventCallback<Photo> SelectedPhotoChanged { get; set; }

    [Parameter]
    public bool isLoading { get; set; }

    [Parameter]
    public EventCallback<bool> IsLoadingChanged { get; set; }

    private string? fullImageData;

    private string title = "Loading Title";

    private EventCallback<string> TitleHasChanged { get; set; }

    private Modal modal = default!;

    public async Task ShowModal(Photo photo)
    {
        await modal.ShowAsync();

        selectedPhoto = photo;
        fullImageData = selectedPhoto != null ? selectedPhoto.ImageSrc : "";
        title = selectedPhoto != null ? $"Full Image: {selectedPhoto.Title}" : "Unable to Load Image";

        isLoading = false;
        await IsLoadingChanged.InvokeAsync(isLoading);
    }

    private async Task CloseModal()
    {
        isLoading = true;
        await IsLoadingChanged.InvokeAsync(isLoading);

        selectedPhoto = null;
        await SelectedPhotoChanged.InvokeAsync(selectedPhoto);

        title = "Loading Title";
        await TitleHasChanged.InvokeAsync(title);

        StateHasChanged();

        await modal.HideAsync();
    }
}